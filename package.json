{
  "name": "expense-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev:web": "pnpm --dir apps/web dev",
    "dev:api": "pnpm --dir apps/api dev",

    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",

    "db:generate": "pnpm --dir packages/database exec prisma generate",
    "db:migrate": "pnpm --dir packages/database exec prisma migrate dev",
    "db:studio": "pnpm --dir packages/database exec prisma studio",
    "db:test:migrate": "dotenv -e ../../apps/api/.env.test -- prisma migrate deploy",

    "test:db:up": "docker compose -f compose.test.yaml up -d --wait",
    "test:db:down": "docker compose -f compose.test.yaml down -v",
    "test:db:migrate": "pnpm -C ./packages/database run db:test:migrate",
    "test:api:unit": "pnpm --dir apps/api test:unit",
    "test:api:integration": "pnpm --dir apps/api exec vitest run --config vitest.integration.config.ts",

    "lint:web": "pnpm -C ./apps/web exec eslint .",

    "typecheck:web": "pnpm -C ./apps/web exec tsc --noEmit",
    "typecheck:api": "pnpm -C ./apps/api exec tsc --noEmit",

    "build:web": "pnpm -C ./apps/web run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.30.3"
}
